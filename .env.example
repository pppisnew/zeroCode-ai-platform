# ZeroCode local configuration
#
# Usage:
#   cp .env.example .env
#   edit .env
#   scripts/start-project.sh
#
# Notes:
# - .env is ignored by git and may contain local secrets.
# - If MySQL has already been initialized with different credentials, run
#   scripts/stop-project.sh --volumes before changing MYSQL_* values.

# Frontend
VITE_API_PROXY_TARGET=http://localhost:8080

# Platform service
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=zerocode
MYSQL_USERNAME=mysql
MYSQL_PASSWORD=zerocode

REDIS_HOST=localhost
REDIS_PORT=6379

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=zerocode
RABBITMQ_PASSWORD=zerocode

AI_SERVICE_BASE_URL=http://localhost:8000
DEPLOY_SERVICE_BASE_URL=http://localhost:8081
PLATFORM_ARTIFACT_BASE_URL=http://localhost:8080/api

MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=zerocode
MINIO_SECRET_KEY=zerocode123
MINIO_BUCKET=zerocode

# LLM provider (openai | anthropic)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.3

# Python AI orchestrator sandbox checks
ZEROCODE_ENABLE_BROWSER_SANDBOX=false
ZEROCODE_ENABLE_DOCKER_SANDBOX=false
ZEROCODE_DOCKER_SANDBOX_IMAGE=node:22-alpine

# Deploy service
DEPLOY_STORE_PATH=/tmp/zerocode-deployments.json

DEPLOY_DOCKER_EXECUTOR_ENABLED=false
DEPLOY_DOCKER_EXECUTION_MODE=dry-run
DEPLOY_DOCKER_WORKSPACE_ROOT=/tmp/zerocode-docker-deployments
DEPLOY_DOCKER_COMMAND_TIMEOUT_SECONDS=300
DEPLOY_DOCKER_IMAGE_REPOSITORY_PREFIX=zerocode
DEPLOY_DOCKER_PUSH_ENABLED=false

DEPLOY_GITHUB_ACTIONS_EXECUTOR_ENABLED=false
DEPLOY_GITHUB_ACTIONS_EXECUTION_MODE=dry-run
DEPLOY_GITHUB_ACTIONS_API_BASE_URL=https://api.github.com
DEPLOY_GITHUB_ACTIONS_TOKEN=
DEPLOY_GITHUB_ACTIONS_OWNER=
DEPLOY_GITHUB_ACTIONS_REPO=
DEPLOY_GITHUB_ACTIONS_WORKFLOW_ID=
DEPLOY_GITHUB_ACTIONS_REF=main

DEPLOY_KUBERNETES_EXECUTOR_ENABLED=false
DEPLOY_KUBERNETES_EXECUTION_MODE=dry-run
DEPLOY_KUBERNETES_NAMESPACE=default
DEPLOY_KUBERNETES_KUBECTL_BINARY=kubectl
DEPLOY_KUBERNETES_KUBECONFIG=
DEPLOY_KUBERNETES_COMMAND_TIMEOUT_SECONDS=300
DEPLOY_KUBERNETES_IMAGE_REPOSITORY_PREFIX=zerocode
DEPLOY_KUBERNETES_SERVICE_PORT=80
